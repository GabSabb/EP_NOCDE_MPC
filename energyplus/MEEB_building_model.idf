!-Generator IDFEditor 1.44
!-Option OriginalOrderTop UseSpecialFormat
!-NOTE: All comments with '!-' are ignored by the IDFEditor and are generated automatically.
!-      Use '!' comments if they need to be retained when using the IDFEditor.

  Output:Constructions,Constructions,Materials;

  Output:Variable,BE3_Wa_SW,Surface Inside Face Temperature,Timestep;

  Output:Variable,BE3_Wa_SW,Surface Outside Face Temperature,Timestep;

  Output:Variable,BE1_Wa_NE,Surface Inside Face Temperature,Timestep;

  Output:Variable,BE1_Wa_NE,Surface Outside Face Temperature,Timestep;

  Output:Variable,DR_Wa_NE,Surface Inside Face Temperature,Timestep;

  Output:Variable,DR_Wa_NE,Surface Outside Face Temperature,Timestep;

  Output:Variable,BE2_Wa_SW,Surface Inside Face Temperature,Timestep;

  Output:Variable,BE2_Wa_SW,Surface Outside Face Temperature,Timestep;

  ShadowCalculation,
    PolygonClipping,         !- Shading Calculation Method
    Periodic,                !- Shading Calculation Update Frequency Method
    5,                       !- Shading Calculation Update Frequency
    15000,                   !- Maximum Figures in Shadow Overlap Calculations
    SutherlandHodgman,       !- Polygon Clipping Algorithm
    ;                        !- Pixel Counting Resolution

  Output:Diagnostics,
    DoNotMirrorDetachedShading;  !- Key 1

                                        !- X,Y,Z  1 {m}
                                        !- X,Y,Z  2 {m}
                                        !- X,Y,Z  3 {m}

  BuildingSurface:Detailed,
    HALL1_D_SW,              !- Name
    Wall,                    !- Surface Type
    Exterior Door,           !- Construction Name
    Hall1,                   !- Zone Name
    ,                        !- Space Name
    Outdoors,                !- Outside Boundary Condition
    ,                        !- Outside Boundary Condition Object
    SunExposed,              !- Sun Exposure
    WindExposed,             !- Wind Exposure
    0.5,                     !- View Factor to Ground
    4,                       !- Number of Vertices
    3.961000000000,-0.456000000000,2.110000000000,  !- X,Y,Z ==> Vertex 1 {m}
    3.961000000000,-0.456000000000,0.000000000000,  !- X,Y,Z ==> Vertex 2 {m}
    3.961000000000,0.864000000000,0.000000000000,  !- X,Y,Z ==> Vertex 3 {m}
    3.961000000000,0.864000000000,2.110000000000;  !- X,Y,Z ==> Vertex 4 {m}

                                        !- X,Y,Z  4 {m}

  Output:Variable,*,Baseboard Electricity Rate,Timestep;

  WindowMaterial:Blind,
    Blinds,                  !- Name
    Horizontal,              !- Slat Orientation
    0.025,                   !- Slat Width {m}
    0.01875,                 !- Slat Separation {m}
    0.001,                   !- Slat Thickness {m}
    45,                      !- Slat Angle {deg}
    0.9,                     !- Slat Conductivity {W/m-K}
    0,                       !- Slat Beam Solar Transmittance
    0.5,                     !- Front Side Slat Beam Solar Reflectance
    0.5,                     !- Back Side Slat Beam Solar Reflectance
    0.0,                     !- Slat Diffuse Solar Transmittance
    0.5,                     !- Front Side Slat Diffuse Solar Reflectance
    0.5,                     !- Back Side Slat Diffuse Solar Reflectance
    0.0,                     !- Slat Beam Visible Transmittance
    0.5,                     !- Front Side Slat Beam Visible Reflectance
    0.5,                     !- Back Side Slat Beam Visible Reflectance
    0.0,                     !- Slat Diffuse Visible Transmittance
    0.5,                     !- Front Side Slat Diffuse Visible Reflectance
    0.5,                     !- Back Side Slat Diffuse Visible Reflectance
    0.0,                     !- Slat Infrared Hemispherical Transmittance
    0.9,                     !- Front Side Slat Infrared Hemispherical Emissivity
    0.9,                     !- Back Side Slat Infrared Hemispherical Emissivity
    0.050,                   !- Blind to Glass Distance {m}
    0,                       !- Blind Top Opening Multiplier
    0,                       !- Blind Bottom Opening Multiplier
    0,                       !- Blind Left Side Opening Multiplier
    0,                       !- Blind Right Side Opening Multiplier
    3,                       !- Minimum Slat Angle {deg}
    176;                     !- Maximum Slat Angle {deg}

  Output:Variable,*,Zone Air Temperature,Timestep;

  Output:Variable,*,Zone Thermostat Heating Setpoint Temperature,Timestep;

